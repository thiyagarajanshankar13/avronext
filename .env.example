# Nextcloud server AvroNext talks to (server side). Required.
NEXTCLOUD_URL=https://cloud.example.com

# Optional: the address browsers use for Nextcloud, when it differs from
# NEXTCLOUD_URL (e.g. NEXTCLOUD_URL is an internal Docker/Railway hostname).
# Used for "Open in Nextcloud" links.
# NEXTCLOUD_PUBLIC_URL=https://cloud.example.com

# Encrypts the session cookie. Required. At least 32 random characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Largest attachment AvroNext accepts, per file, in MB (default 100).
# Nextcloud's own upload limits still apply.
# MAX_UPLOAD_MB=100

# Set to "false" only when serving AvroNext over plain http outside localhost.
# COOKIE_SECURE=true

# ---- Mail (optional; needs the Nextcloud Mail app) ----
# The mail server people connect to when they first open Mail. Mail stays
# hidden until MAIL_IMAP_HOST and MAIL_SMTP_HOST are set.
# MAIL_IMAP_HOST=mail.example.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_SECURITY=ssl        # ssl (implicit TLS) | tls (STARTTLS) | none
# MAIL_SMTP_HOST=mail.example.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURITY=ssl
# Username suggested on the connect screen (people can change it):
# %EMAIL% (default), %USERID%, or e.g. %USERID%@example.com
# MAIL_USERNAME=%EMAIL%
